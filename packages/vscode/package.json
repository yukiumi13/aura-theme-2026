{
  "name": "aura-theme-2026",
  "displayName": "Aura Modern",
  "description": "Dark and light themes: Aura, Aqua, Lime, and Azure, plus Aqua Lime Light with brighter summer syntax. An independent fork of Aura by Dalton Menezes.",
  "version": "0.9.6",
  "scripts": {
    "publish": "vsce publish"
  },
  "publisher": "yukiumi13",
  "author": {
    "name": "yukiumi13",
    "url": "https://github.com/yukiumi13"
  },
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#09080D",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension/extension.js",
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "light",
    "aqua",
    "lime",
    "azure",
    "aura-theme-2026",
    "color-theme"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.experimental.modernUIEditorTabStyle": "pill"
    },
    "configuration": {
      "title": "Aura Modern",
      "properties": {
        "aura.experimental.gradients": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Enable experimental mint/cyan button gradients, cyan-to-green numeric activity badges, and shared focus rings on inputs, primary buttons, toolbar icons and notification cards in Aqua Light and Aqua Lime Light. Requires **Custom CSS and JS Loader** (be5invis.vscode-custom-css), which modifies your local VS Code installation. Use **Aura: Apply Gradient Setting** and reload after changing this setting or updating Aura. Updates to VS Code can require reapplying. Desktop only; styles affect matching themes in all windows of this installation."
        }
      }
    },
    "commands": [
      {
        "command": "aura.gradients.apply",
        "title": "Aura: Apply Gradient Setting"
      },
      {
        "command": "aura.gradients.status",
        "title": "Aura: Show Gradient Status"
      }
    ],
    "themes": [
      {
                "id": "Aura 2026 Dark",
                "label": "Aura Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/aura-dark-color-theme.json"
        },
        {
                "id": "Aura Light 2026",
                "label": "Aura Light",
                "uiTheme": "vs",
                "path": "./themes/aura-light-2026-color-theme.json"
        },
        {
                "id": "Aura Aqua Light 2026",
                "label": "Aura Aqua Light",
                "uiTheme": "vs",
                "path": "./themes/aura-aqua-light-2026-color-theme.json"
        },
        {
                "id": "Aura Aqua Dark 2026",
                "label": "Aura Aqua Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/aura-aqua-dark-2026-color-theme.json"
        },
        {
                "id": "Aura Aqua Lime Light",
                "label": "Aura Aqua Lime Light",
                "uiTheme": "vs",
                "path": "./themes/aura-aqua-lime-light-color-theme.json"
        },
        {
                "id": "Aura Lime Light",
                "label": "Aura Lime Light",
                "uiTheme": "vs",
                "path": "./themes/aura-lime-light-color-theme.json"
        },
        {
                "id": "Aura Lime Dark",
                "label": "Aura Lime Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/aura-lime-dark-color-theme.json"
        },
        {
                "id": "Aura 2026 Azure Light",
                "label": "Aura Azure Light",
                "uiTheme": "vs",
                "path": "./themes/aura-azure-light-2026-color-theme.json"
        },
        {
                "id": "Aura Azure 2026",
                "label": "Aura Azure Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/aura-azure-2026-color-theme.json"
        }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yukiumi13/aura-theme-2026.git"
  },
  "bugs": {
    "url": "https://github.com/yukiumi13/aura-theme-2026/issues"
  }
}
