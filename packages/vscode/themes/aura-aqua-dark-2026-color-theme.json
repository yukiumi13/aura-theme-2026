  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment",
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#9DB9C6"
      }
    },
    {
      "scope": [
        "constant.other.placeholder",
        "constant.character"
      ],
      "settings": {
        "foreground": "#FF9BCF"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "variable.language",
        "entity",
        "support.constant",
        "support.variable",
        "meta.module-reference"
      ],
      "settings": {
        "foreground": "#64D8F3"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFC98A"
      }
    },
    {
      "scope": [
        "meta.export.default",
        "meta.definition.variable",
        "markup.changed",
        "entity.name.section.markdown",
        "support.function"
      ],
      "settings": {
        "foreground": "#DDA7FF"
      }
    },
    {
      "scope": [
        "variable.parameter.function",
        "variable.parameter",
        "meta.function-call.arguments.python variable.parameter"
      ],
