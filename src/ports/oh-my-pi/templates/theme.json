{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/v19.0.1/packages/tui/src/theme/theme-schema.json",
  "name": "{{ id }}",
  "colors": {
    "accent": "{{ labelAccent }}",
    "border": "{{ baseBorder }}",
    "borderAccent": "{{ uiAccent }}",
    "borderMuted": "{{ baseBorder }}",
    "success": "{{ uiStatusSuccess }}",
    "error": "{{ statusError }}",
    "warning": "{{ uiStatusWarning }}",
    "muted": "{{ baseForegroundMuted }}",
    "dim": "{{ baseForegroundSubtle }}",
    "text": "{{ baseForeground }}",
    "assistantMessageText": "{{ baseForeground }}",
    "thinkingText": "{{ baseForegroundMuted }}",
    "selectedBg": "{{ selectedBg }}",
    "userMessageBg": "{{ messageBg }}",
    "userMessageText": "{{ baseForeground }}",
    "customMessageBg": "{{ baseAppBackground }}",
    "customMessageText": "{{ baseForeground }}",
    "customMessageLabel": "{{ labelAccent }}",
    "toolPendingBg": "{{ baseAppBackground }}",
    "toolSuccessBg": "{{ baseAppBackground }}",
    "toolErrorBg": "{{ errorBg }}",
    "toolTitle": "{{ baseForegroundStrong }}",
    "toolOutput": "{{ baseForeground }}",
    "mdHeading": "{{ syntaxFunctionDeclaration }}",
    "mdLink": "{{ uiLinkForeground }}",
    "mdExtensionLink": "{{ syntaxFunction }}",
    "mdLinkUrl": "{{ baseForegroundMuted }}",
    "mdCode": "{{ syntaxString }}",
    "mdCodeBlock": "{{ baseForeground }}",
    "mdCodeBlockBorder": "{{ baseBorder }}",
    "mdQuote": "{{ baseForegroundMuted }}",
    "mdQuoteBorder": "{{ uiActiveBorder }}",
    "mdHr": "{{ baseBorder }}",
    "mdListBullet": "{{ labelAccent }}",
    "toolDiffAdded": "{{ uiStatusSuccess }}",
    "toolDiffRemoved": "{{ statusError }}",
    "toolDiffContext": "{{ baseForeground }}",
    "syntaxComment": "{{ syntaxComment }}",
    "syntaxKeyword": "{{ syntaxKeyword }}",
    "syntaxFunction": "{{ syntaxFunctionDeclaration }}",
    "syntaxVariable": "{{ syntaxVariable }}",
    "syntaxString": "{{ syntaxString }}",
    "syntaxNumber": "{{ syntaxNumber }}",
    "syntaxType": "{{ syntaxType }}",
    "syntaxOperator": "{{ syntaxOperator }}",
    "syntaxPunctuation": "{{ syntaxPunctuation }}",
    "thinkingOff": "{{ baseBorder }}",
    "thinkingMinimal": "{{ baseBorderStrong }}",
    "thinkingLow": "{{ uiLinkForeground }}",
    "thinkingMedium": "{{ uiLinkHoverForeground }}",
    "thinkingHigh": "{{ syntaxFunction }}",
    "thinkingXhigh": "{{ syntaxFunctionDeclaration }}",
    "thinkingMax": "{{ syntaxProperty }}",
    "bashMode": "{{ uiStatusSuccess }}",
    "pythonMode": "{{ uiStatusWarning }}",
    "btwMode": "{{ uiLinkForeground }}",
    "statusLineBg": "{{ baseAppBackground }}",
    "statusLineSep": "{{ baseBorderStrong }}",
    "statusLineModel": "{{ syntaxFunction }}",
    "statusLinePath": "{{ baseForegroundMuted }}",
    "statusLineGitClean": "{{ uiStatusSuccess }}",
    "statusLineGitDirty": "{{ uiStatusModified }}",
    "statusLineContext": "{{ baseForegroundMuted }}",
    "statusLineSpend": "{{ uiStatusWarning }}",
    "statusLineStaged": "{{ uiStatusSuccess }}",
    "statusLineDirty": "{{ uiStatusModified }}",
    "statusLineUntracked": "{{ ansiCyan }}",
    "statusLineOutput": "{{ baseForegroundSubtle }}",
    "statusLineCost": "{{ uiStatusWarning }}",
    "statusLineSubagents": "{{ labelAccent }}"
  },
  "export": {
    "pageBg": "{{ baseBackground }}",
    "cardBg": "{{ baseAppBackground }}",
    "infoBg": "{{ messageBg }}"
  },
  "terminal": {
    "background": "{{ baseBackground }}",
    "foreground": "{{ baseForeground }}",
    "chrome": "{{ baseAppBackground }}",
    "widget": "{{ baseElevated }}",
    "ansi": [
      "{{ ansiBlack }}",
      "{{ ansiRed }}",
      "{{ ansiGreen }}",
      "{{ ansiYellow }}",
      "{{ ansiBlue }}",
      "{{ ansiMagenta }}",
      "{{ ansiCyan }}",
      "{{ ansiWhite }}",
      "{{ ansiBrightBlack }}",
      "{{ ansiBrightRed }}",
      "{{ ansiBrightGreen }}",
      "{{ ansiBrightYellow }}",
      "{{ ansiBrightBlue }}",
      "{{ ansiBrightMagenta }}",
      "{{ ansiBrightCyan }}",
      "{{ ansiBrightWhite }}"
    ]
  }
}
