{
  "name": "{{ slug }}",
  "displayName": "Aura Theme 2026 (Unofficial Fork)",
  "description": "An independently maintained Aura Theme fork with Aqua, light, and dark palettes. Based on the original theme by Dalton Menezes.",
  "version": "{{ version }}",
  "scripts": {
    "publish": "vsce publish"
  },
  "publisher": "yukiumi13",
  "author": {
    "name": "yukiumi13",
    "url": "https://github.com/yukiumi13"
  },
  "icon": "logo.png",
  "galleryBanner": {
    "color": "{{ accent12 }}",
    "theme": "{{ type }}"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.47.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "light",
    "{{ slug }}",
    "color-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "{{ auraDarkSoftText }}",
        "uiTheme": "vs-dark",
        "path": "./themes/aura-dark-soft-text-color-theme.json"
      },
      {
        "label": "{{ auraDark }}",
        "uiTheme": "vs-dark",
        "path": "./themes/aura-dark-color-theme.json"
      },
      {
        "label": "{{ auraSoftDarkSoftText }}",
        "uiTheme": "vs-dark",
        "path": "./themes/aura-soft-dark-soft-text-color-theme.json"
      },
      {
        "label": "{{ auraSoftDark }}",
        "uiTheme": "vs-dark",
        "path": "./themes/aura-soft-dark-color-theme.json"
      },
      {{{ variantThemes }}}
    ]
  },
  "repository": {
    "type": "git",
    "url": "{{{ repository }}}.git"
  },
  "bugs": {
    "url": "{{{ repository }}}/issues"
  }
}
