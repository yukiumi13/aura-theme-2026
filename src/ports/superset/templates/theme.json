{
  "id": "{{ id }}",
  "name": "{{ name }}",
  "type": "{{ type }}",
  "version": "{{ version }}",
  "author": "Aura Modern contributors; based on Aura by Dalton Menezes",
  "description": "{{ name }}: shared Aura surfaces, syntax and terminal roles for Superset.",
  "ui": {
    "background": "{{ baseBackground }}",
    "foreground": "{{ baseForeground }}",
    "card": "{{ uiSurfacePanel }}",
    "cardForeground": "{{ baseForeground }}",
    "popover": "{{ uiSurfaceElevated }}",
    "popoverForeground": "{{ baseForeground }}",
    "primary": "{{ uiActionBackground }}",
    "primaryForeground": "{{ uiActionForeground }}",
    "secondary": "{{ baseSurface }}",
    "secondaryForeground": "{{ baseForeground }}",
    "muted": "{{ baseSurfaceAlt }}",
    "mutedForeground": "{{ baseForegroundMuted }}",
    "accent": "{{ uiSurfaceHover }}",
    "accentForeground": "{{ baseForegroundStrong }}",
    "tertiary": "{{ basePanel }}",
    "tertiaryActive": "{{ uiSurfaceHover }}",
    "destructive": "{{ uiStatusError }}",
    "destructiveForeground": "{{ uiOnError }}",
    "warning": "{{ uiStatusWarning }}",
    "warningForeground": "{{ baseBackground }}",
    "success": "{{ uiStatusSuccess }}",
    "border": "{{ baseBorder }}",
    "input": "{{ baseBorder }}",
    "ring": "{{ uiFocusBorder }}",
    "sidebar": "{{ baseSidebar }}",
    "sidebarForeground": "{{ baseForeground }}",
    "sidebarPrimary": "{{ uiActionBackground }}",
    "sidebarPrimaryForeground": "{{ uiActionForeground }}",
    "sidebarAccent": "{{ uiListSelectionBackground }}",
    "sidebarAccentForeground": "{{ baseForegroundStrong }}",
    "sidebarBorder": "{{ uiChromeBorder }}",
    "sidebarRing": "{{ uiFocusBorder }}",
    "chart1": "{{ uiChartSeries1 }}",
    "chart2": "{{ uiChartSeries2 }}",
    "chart3": "{{ uiChartSeries3 }}",
    "chart4": "{{ uiChartSeries4 }}",
    "chart5": "{{ uiChartSeries5 }}",
    "highlightMatch": "{{ uiEditorSelection }}",
    "highlightActive": "{{ uiEditorSelectionStrong }}",
    "highlight": "{{ uiBadgeBackground }}",
    "highlightForeground": "{{ uiBadgeForeground }}"
  },
  "terminal": {
    "background": "{{ terminalSurfaceBackground }}",
    "foreground": "{{ terminalSurfaceForeground }}",
    "cursor": "{{ terminalCursor }}",
    "cursorAccent": "{{ terminalCursorText }}",
    "selectionBackground": "{{ terminalSelectionBackground }}",
    "selectionForeground": "{{ terminalSelectionForeground }}",
    "black": "{{ ansiBlack }}",
    "red": "{{ ansiRed }}",
    "green": "{{ ansiGreen }}",
    "yellow": "{{ ansiYellow }}",
    "blue": "{{ ansiBlue }}",
    "magenta": "{{ ansiMagenta }}",
    "cyan": "{{ ansiCyan }}",
    "white": "{{ ansiWhite }}",
    "brightBlack": "{{ ansiBrightBlack }}",
    "brightRed": "{{ ansiBrightRed }}",
    "brightGreen": "{{ ansiBrightGreen }}",
    "brightYellow": "{{ ansiBrightYellow }}",
    "brightBlue": "{{ ansiBrightBlue }}",
    "brightMagenta": "{{ ansiBrightMagenta }}",
    "brightCyan": "{{ ansiBrightCyan }}",
    "brightWhite": "{{ ansiBrightWhite }}"
  },
  "editor": {
    "colors": {
      "background": "{{ baseBackground }}",
      "foreground": "{{ baseForeground }}",
      "border": "{{ baseBorder }}",
      "cursor": "{{ uiAccentBright }}",
      "gutterBackground": "{{ baseBackground }}",
      "gutterForeground": "{{ uiEditorLineNumber }}",
      "activeLine": "{{ uiEditorLineHighlight }}",
      "selection": "{{ uiEditorSelection }}",
      "search": "{{ uiEditorSelection }}",
      "searchActive": "{{ uiEditorSelectionStrong }}",
      "panel": "{{ uiSurfaceElevated }}",
      "panelBorder": "{{ baseBorder }}",
      "panelInputBackground": "{{ baseBackground }}",
      "panelInputForeground": "{{ baseForeground }}",
      "panelInputBorder": "{{ baseBorder }}",
      "panelButtonBackground": "{{ uiActionBackground }}",
      "panelButtonForeground": "{{ uiActionForeground }}",
      "panelButtonBorder": "{{ uiActionBorder }}",
      "diffBuffer": "{{ baseSurfaceAlt }}",
      "diffHover": "{{ uiSurfaceHover }}",
      "diffSeparator": "{{ baseBorder }}",
      "addition": "{{ uiStatusSuccess }}",
      "deletion": "{{ uiStatusError }}",
      "modified": "{{ uiStatusModified }}"
    },
    "syntax": {
      "plainText": "{{ baseForeground }}",
      "comment": "{{ syntaxComment }}",
      "keyword": "{{ syntaxKeyword }}",
      "string": "{{ syntaxString }}",
      "number": "{{ syntaxNumber }}",
      "functionCall": "{{ syntaxFunction }}",
      "variableName": "{{ syntaxVariable }}",
      "typeName": "{{ syntaxType }}",
      "className": "{{ syntaxClass }}",
      "constant": "{{ syntaxConstant }}",
      "regexp": "{{ syntaxRegexp }}",
      "tagName": "{{ syntaxTag }}",
      "attributeName": "{{ syntaxAttribute }}",
      "invalid": "{{ uiStatusError }}"
    }
  }
}
